AUTOCOUNT_BASE_URL=https://accounting-api.autocountcloud.com
AUTOCOUNT_ACCOUNT_BOOK_ID=your_account_book_id
AUTOCOUNT_KEY_ID=your_key_id
AUTOCOUNT_API_KEY=your_api_key
SYNC_OUTPUT_DIR=data
SYNC_MAX_PAGES=500
SYNC_SAVE_HISTORY=true

# PostgreSQL 数据库连接（Railway 自动注入 DATABASE_URL）
DATABASE_URL=postgresql://user:password@localhost:5432/jinza_os
# 如果数据库不需要 SSL，设为 false
# DB_SSL=false
